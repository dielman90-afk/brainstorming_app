# Anthropic API-Key (nur serverseitig verwendet, niemals in den Client einbauen!)
# Key erstellen: https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Port des Express-Proxys (Vite proxied /api dorthin)
PORT=3001

# Zum Testen ohne API-Key: MOCK_AI=1 liefert statische Beispiel-Ideen
MOCK_AI=0
